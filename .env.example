
# Nothing is required. Without these the app uses the shared server DB and a dev JWT secret
# from application.yaml. Set them only to override.

# Another database, e.g. the local one from compose.yaml
DB_URL=jdbc:postgresql://localhost:5433/dtrps
DB_USER=dtrps
DB_PASSWORD=local_dev_only
# update adds missing tables and columns, validate only checks them
DDL_AUTO=update

# At least 32 characters. Generate one with: openssl rand -hex 32
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
AUTH_RATE_LIMIT_PER_MINUTE=20
AUTH_MAX_FAILED_LOGINS=10
AUTH_LOGIN_LOCK_DURATION=15m

# Set both to create an admin at startup, then remove ADMIN_PASSWORD.
# On the shared DB this creates a real admin.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=System Admin

# Image uploads. Copy from Cloudinary > API Keys: cloudinary://<api_key>:<api_secret>@<cloud_name>
# Locally you can put this line in .env.local (gitignored, read automatically on start).
CLOUDINARY_URL=

# Goong map services (address search, directions). Copy the "API Key" (not the Maptiles key)
# from account.goong.io. Locally put it in .env.local like CLOUDINARY_URL.
GOONG_API_KEY=

# OTP emails (sign-up, password reset). Gmail address + an App Password (Google Account >
# Security > 2-Step Verification > App passwords) — never the Gmail password. Locally put them in
# .env.local. Without them the code is printed to the backend log instead of being sent.
MAIL_USERNAME=
MAIL_PASSWORD=

# PayOS payments (my.payos.vn > Payment channel): Client ID, API Key, Checksum Key. Put the real
# values in .env.local and share them privately — the checksum key signs payment data.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=


# Google sign-in: the web OAuth Client ID, used to check Google ID tokens (no client secret needed).
GOOGLE_CLIENT_ID=54746424739-cc9e6looukqbrvu6ud7tvn54cuas8keg.apps.googleusercontent.com

# AI recommendation (embeddings). OpenAI API key — put the real value in .env.local, never here.
OPENAI_API_KEY=
